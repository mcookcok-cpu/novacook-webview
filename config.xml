<?xml version='1.0' encoding='utf-8'?>
<widget id="com.novacook.webview" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>NovaCook Viewer</name>
    <description>Aplikasi WebView Kloning Kustom Berbasis Cordova</description>
    <author email="support@novacook.local" href="https://novacook.local">NovaCook Team</author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
    <access origin="*" />
    <preference name="Fullscreen" value="false" />
    <preference name="Orientation" value="default" />
</widget>